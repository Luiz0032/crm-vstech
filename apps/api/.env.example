# Copie este arquivo para apps/api/.env e preencha os valores.
# No painel do Neon: Project > Dashboard > botão "Connect".
# Escolha a branch/banco, e copie a "Connection string".

# Banco de desenvolvimento, conexão COM pooler
# (ative "Connection pooling" no Connect; o host termina em "-pooler").
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/crm_dev?sslmode=require"

# Mesmo banco de desenvolvimento, conexão DIRETA
# (desative "Connection pooling"; host sem "-pooler"). Usada pelo Prisma nas migrações.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/crm_dev?sslmode=require"

# Banco de teste (outro banco ou outra branch no Neon), usado pelos testes.
DATABASE_URL_TEST="postgresql://USUARIO:SENHA@ep-yyyy.REGIAO.aws.neon.tech/crm_test?sslmode=require"

PORT=3333
NODE_ENV=development
