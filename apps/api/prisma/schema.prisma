// Prisma ORM 7: as URLs de conexão não ficam mais aqui.
// O CLI (migrate, db pull) lê a conexão do prisma.config.ts (DIRECT_URL);
// o Prisma Client recebe a DATABASE_URL pelo adapter @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  demo

  @@map("role")
}

enum LeadStatus {
  novo
  em_contato
  proposta_enviada
  fechado
  perdido

  @@map("lead_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash") // coluna snake_case no banco
  role         Role     @default(demo) // usa o enum
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at") // atualiza sozinho

  @@map("users") // nome da tabela
}

model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  source    String?
  status    LeadStatus @default(novo)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("leads")
}
